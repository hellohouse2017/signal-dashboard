<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.signal.data-updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/tangyukao/Documents/Antigravity/選股策略/scanner/data_updater.py</string>
        <string>--git-push</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/tangyukao/Documents/Antigravity/選股策略/scanner</string>
    <key>StartCalendarInterval</key>
    <dict>
        <!-- 每天台灣時間 06:30 (比 TG 通知晚 30 分鐘，確保美股已收盤) -->
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/data-updater.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/data-updater.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
